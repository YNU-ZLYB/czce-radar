# 复制为 deploy/.env 后按需修改：cp deploy/.env.example deploy/.env
# 该文件不要提交到 git（含密码）

# ===== 必填 =====
# 数据库密码（db 容器与 api/worker 的连接串共用这一个值）
POSTGRES_PASSWORD=请改成随机强密码
POSTGRES_USER=czce
POSTGRES_DB=czce

# 服务器公网 IP 或域名（仅用于 CORS_ORIGINS 与文档说明）
PUBLIC_HOST=119.91.222.51

# 接口鉴权 token（随机串，现网接口暂为只读，留作后续写接口使用）
API_TOKEN=请改成随机长串

# ===== 选填 =====
LOG_LEVEL=INFO

# 国内构建加速（清华 PyPI 镜像）；留空则用官方源
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 资讯 LLM 抽取（不填则只用规则抽取，成本为 0）
# LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_DAILY_BUDGET_CNY=5
