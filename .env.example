# ===== 必填 =====
# PostgreSQL（生产用 Supabase 连接串）
# sslmode=require 会被自动转成 asyncpg 需要的 ssl=require，直接粘贴官方连接串即可
DATABASE_URL=postgresql+asyncpg://czce:czce@localhost:5432/czce

# Redis（生产用 Upstash 的 rediss:// 连接串）
REDIS_URL=redis://localhost:6379/0

# ===== 选填（有默认值）=====
APP_ENV=local
LOG_LEVEL=INFO
API_TOKEN=change-me-in-production
CORS_ORIGINS=["http://localhost:5173"]
WORKER_HEARTBEAT_TTL_SEC=90

# 资讯 LLM 抽取（可选；不填则只用规则抽取，成本为 0）
# LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_DAILY_BUDGET_CNY=5
LLM_PRICE_IN_CNY_PER_1K=0.001
LLM_PRICE_OUT_CNY_PER_1K=0.002
